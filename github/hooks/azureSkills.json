                "linux": "bash --noprofile --norc -c 'chmod +x \"$HOME/.github/hooks/azureSkills/scripts/track-telemetry.sh\" && \"$HOME/.github/hooks/azureSkills/scripts/track-telemetry.sh\"'",
                "osx": "bash --noprofile --norc -c 'chmod +x \"$HOME/.github/hooks/azureSkills/scripts/track-telemetry.sh\" && \"$HOME/.github/hooks/azureSkills/scripts/track-telemetry.sh\"'",
                "powershell": "& \"$HOME/.github/hooks/azureSkills/scripts/track-telemetry.ps1\"",
                "bash": "bash --noprofile --norc -c 'chmod +x \"$HOME/.github/hooks/azureSkills/scripts/track-telemetry.sh\" && \"$HOME/.github/hooks/azureSkills/scripts/track-telemetry.sh\"'",
                "env": {
                    "AZURE_SKILLS_HOOK_CLIENT_FAMILY": "copilot-vscode"
                }
            }

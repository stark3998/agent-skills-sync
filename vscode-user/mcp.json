{
	"servers": {
		"io.github.hashicorp/terraform-mcp-server": {
			"type": "stdio",
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"-e",
				"TFE_ADDRESS=${input:address}",
				"-e",
				"TFE_TOKEN=${input:token}",
				"-e",
				"ENABLE_TF_OPERATIONS=${input:enabled}",
				"docker.io/hashicorp/terraform-mcp-server:0.5.0"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.5.0"
		},
		"com.postman/postman-mcp-server": {
			"type": "http",
			"url": "https://mcp.postman.com/mcp",
			"headers": {
				"Authorization": "${input:Authorization}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "2.8.7"
		}
	},
	"inputs": [
		{
			"id": "address",
			"type": "promptString",
			"description": "",
			"password": false,
			"default": "https://app.terraform.io"
		},
		{
			"id": "token",
			"type": "promptString",
			"description": "",
			"password": true
		},
		{
			"id": "enabled",
			"type": "promptString",
			"description": "",
			"password": false,
			"default": "false"
		},
		{
			"id": "Authorization",
			"type": "promptString",
			"description": "A Bearer token and a valid Postman API key for authentication.",
			"password": true
		}
	]
}